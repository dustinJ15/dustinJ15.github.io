---
/**
 * The small verifiable figures for a case study.
 *
 * Rendered only when the collection supplies them, and every value has to be
 * traceable to a sentence in that study's own prose. Nothing here is a
 * dashboard counter: no animation, no invented percentages, no rounding a
 * "substantially" into a number.
 */
interface Props {
  metrics: readonly { value: string; label: string }[];
}
const { metrics } = Astro.props;
---

{
  metrics.length > 0 && (
    <dl class="flex flex-wrap gap-x-12 gap-y-8">
      {metrics.map((m) => (
        <div>
          <dt class="sr-only">{m.label}</dt>
          <dd>
            <span class="block font-display text-5xl font-extrabold leading-none tracking-tight text-accent">
              {m.value}
            </span>
            <span class="mt-3 block max-w-40 font-mono text-2xs uppercase leading-relaxed tracking-[0.14em] text-ink-faint">
              {m.label}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  )
}
