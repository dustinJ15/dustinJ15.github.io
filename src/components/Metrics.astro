---
/**
 * The small verifiable figures for a case study.
 *
 * Rendered only when the collection supplies them, and every value has to be
 * traceable to a sentence in that study's own prose. Nothing here is a
 * dashboard counter: no animation, no invented percentages, no rounding a
 * "substantially" into a number.
 */
interface Props {
  metrics: readonly { value: string; label: string }[];
}
const { metrics } = Astro.props;
---

{
  metrics.length > 0 && (
    <dl class="flex flex-wrap items-start gap-x-12 gap-y-8">
      {metrics.map((m) => (
        /* Reordered rather than duplicated: a <dl> group has to be dt then dd,
           and the label used to be repeated into an sr-only dt, which read the
           same words twice. `order` rather than column-reverse, which packs from
           the bottom and so drops the value of a one-line label below the value
           of a two-line one. */
        <div class="flex max-w-40 flex-col">
          <dt class="order-2 mt-3 font-mono text-2xs uppercase leading-relaxed tracking-[0.14em] text-ink-faint">
            {m.label}
          </dt>
          <dd class="order-1 font-display text-5xl font-extrabold leading-none tracking-tight text-accent">
            {m.value}
          </dd>
        </div>
      ))}
    </dl>
  )
}
