---
/**
 * One case study.
 *
 * Every route under /projects/ is generated from the content collection, so
 * adding a fifth study is dropping one markdown file into src/content/projects
 * and nothing else: this page, the home page work rail and the "next" link at
 * the bottom all pick it up.
 *
 * The shape is Obys chrome around calm prose. The title block and the outcome
 * are the loud part, because a recruiter who reads only the first screenful
 * should still leave with the outcome. Everything below the outcome is a
 * reading page: one measure, no pinning, and body copy painted before any
 * scroll-triggered animation runs.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Outcome from '../../components/Outcome.astro';
import Metrics from '../../components/Metrics.astro';
import Chapters from '../../components/Chapters.astro';
import { slug } from '../../plugins/slug.mjs';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    // Wrapping to the first study rather than stopping, so the bottom of every
    // case study has somewhere to go.
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { title, year, role, stack, code, summary, outcome, metrics } = project.data;
const { Content } = await render(project);

// Chapters, read off the markdown source: one per `##`. The id is the same
// slug the markdown plugin stamps on the h2, so the link and the heading agree.
const chapters = project.data.chapters
  ? (project.body ?? '')
      .split(/^## /m)
      .slice(1)
      .map((section) => section.split('\n')[0].trim())
      .map((heading) => ({ title: heading, id: slug(heading) }))
  : [];

// One <span data-line> per word. The gate fails a display line that wraps, and a
// word is the only unit that cannot: the words stack instead of reflowing, and
// the type is sized against the longest of them so a short title ("Label Maker")
// is set as large as its line allows rather than being held down by the longest
// title in the collection.
const words = title.split(' ');
const longest = Math.max(...words.map((w) => w.length));
---

<BaseLayout title={title} description={summary} ogType="article">
  <!-- ── title ─────────────────────────────────────────────────────────── -->
  <section
    class="flex min-h-[calc(100svh-11rem)] flex-col justify-between gap-16 px-(--gutter) pb-12 pt-4"
  >
    <p class="label">
      Case study <span class="text-ink-soft">/</span> {year}
    </p>

    <h1
      class="display-title font-display font-extrabold uppercase leading-[0.82] tracking-[-0.035em]"
      style={`--title-chars: ${longest}`}
    >
      {
        /* The mask the characters rise out of. It has to sit near the baseline,
           but Bricolage's uppercase Q hangs a heavy tail below it, and a hard
           clip there beheads the tail on "Quote Generator". overflow-clip plus a
           clip margin keeps the mask and lets the tail through. */
        words.map((word, i) => (
          <Fragment>
            {/* The words are separate block elements, so without this the
                heading's textContent is "QuoteGenerator" and copying it out of
                the page loses the space. */}
            {i > 0 && ' '}
            <span class="block overflow-clip [overflow-clip-margin:0.34em]">
              <span
                data-line
                class:list={[
                  'block',
                  // The site-wide accent rule, stated in full on PageTitle: the
                  // accent marks the last line of a title that HAS more than
                  // one. A one-word title would set in ink rather than come out
                  // entirely in the accent.
                  words.length > 1 && i === words.length - 1 && 'text-accent',
                  i % 2 === 1 && 'lg:pl-[10vw]',
                ]}
              >
                {word}
              </span>
            </span>
          </Fragment>
        ))
      }
    </h1>

    <div class="grid gap-8 border-t border-line pt-6 lg:grid-cols-12">
      {/* The summary is the meta description. On the page it is the lede only
          when a study has no outcome pair to open with; otherwise the outcome
          band below says the same thing louder and the lede would say it twice.
          Not revealed on scroll: it sits inside the first screenful. */}
      {!outcome && <p class="measure text-lg leading-relaxed text-ink lg:col-span-7">{summary}</p>}
      <dl
        class:list={[
          'grid gap-6 self-start sm:grid-cols-2',
          outcome ? 'lg:col-span-12 lg:grid-cols-4' : 'lg:col-span-4 lg:col-start-9',
        ]}
      >
        <div>
          <dt class="label">Role</dt>
          <dd class="mt-2 text-base text-ink-soft">{role}</dd>
        </div>
        <div>
          <dt class="label">Code</dt>
          <dd class="mt-2 text-base text-ink-soft">
            {
              code.href ? (
                <a class="text-accent underline underline-offset-4 hover:no-underline" href={code.href}>
                  {code.label}
                </a>
              ) : (
                <Fragment>
                  {code.label}
                  {/* Three of four studies cannot show their code. The Process
                      page is what stands in for it, so it is linked from the line
                      that says the code is private rather than only from the nav. */}
                  <a class="label mt-2 block transition-colors hover:text-accent" href="/process/">
                    How it was built →
                  </a>
                </Fragment>
              )
            }
          </dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="label">Stack</dt>
          <dd>
            <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
              {
                stack.map((s) => (
                  <li class="font-mono text-2xs uppercase tracking-wider text-ink-faint">{s}</li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {/* Both halves are optional on the collection, so the band itself is too: a
      study with neither would otherwise leave an empty stripe of padding. */}
  <!-- ── outcome and metrics, above the argument ───────────────────────── -->
  {
    (outcome || metrics.length > 0) && (
      <section class="px-(--gutter) py-16 lg:py-24">
        {outcome && <Outcome before={outcome.before} after={outcome.after} />}
        {metrics.length > 0 && (
          <div class:list={['flex flex-wrap items-start gap-x-16 gap-y-10', outcome && 'mt-16']}>
            <p class="label w-full lg:w-auto lg:max-w-24">By the numbers</p>
            <Metrics metrics={metrics} />
          </div>
        )}
      </section>
    )
  }

  {/* The chapter list and the argument. On a narrow screen the list is in
      flow, ruled, under the metrics band. From xl the two share a grid: the
      argument in the first column, the list sticky in a 16rem second column of
      its own. The prose grid's fr tracks collapse to whatever the first column
      leaves, so a figure spanning `wide` ends before the list by construction.
      Nothing is fixed and nothing floats over the prose. */}
  <!-- ── chapters and the argument ─────────────────────────────────────── -->
  <div class:list={[chapters.length > 0 && 'xl:grid xl:grid-cols-[minmax(0,1fr)_16rem] xl:gap-x-8 xl:pr-(--gutter)']}>
    {
      chapters.length > 0 && (
        <Chapters
          chapters={chapters}
          back={{ label: 'All work', href: '/' }}
          class="xl:sticky xl:top-24 xl:order-last xl:self-start xl:pt-2"
        />
      )
    }
    <div class="prose pb-24">
      <Content />
    </div>
  </div>

  <!-- ── next ──────────────────────────────────────────────────────────── -->
  <section class="border-t border-line px-(--gutter) py-16">
    <p class="label">Next case study</p>
    <a
      href={`/projects/${next.id}/`}
      class="group mt-6 flex flex-wrap items-baseline gap-x-8 gap-y-2"
    >
      <span
        class="font-display text-[clamp(2rem,9vw,5.5rem)] font-extrabold uppercase leading-none tracking-tight text-ink transition-colors duration-300 group-hover:text-accent"
        >{next.data.title}</span
      >
      <span class="label transition-colors group-hover:text-accent">{next.data.year}</span>
    </a>
    <div class="mt-12 flex flex-wrap gap-6 border-t border-line pt-6">
      <a class="label transition-colors hover:text-accent" href="/">All work</a>
      <a class="label transition-colors hover:text-accent" href="/process/">Process</a>
      <a class="label transition-colors hover:text-accent" href="/about/">About</a>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    withMotion,
    revealDisplayTitle,
    revealOnScroll,
    chapterNav,
    onTeardown,
  } from '../../scripts/motion';

  // The chapter list, where a study has one.
  const nav = document.getElementById('chapters');
  if (nav) chapterNav(nav);

  // Which captures are taller than their window. Measured after the images
  // have their layout size, so the hint is only drawn on a frame that scrolls.
  // The same pass hands a tall frame's wheel to its own scroller: Lenis reads
  // `data-lenis-prevent` off the event path, and Lenis only exists with JS, so
  // the attribute is set here rather than baked into the markup.
  const markTall = () => {
    document.querySelectorAll<HTMLElement>('.shot-frame').forEach((frame) => {
      const body = frame.querySelector<HTMLElement>('.shot-body');
      if (!body) return;
      const tall = body.scrollHeight > body.clientHeight + 1;
      frame.toggleAttribute('data-tall', tall);
      body.toggleAttribute('data-lenis-prevent', tall);
    });
  };
  markTall();
  const ro = new ResizeObserver(markTall);
  document.querySelectorAll('.shot-body img').forEach((img) => ro.observe(img));
  onTeardown(() => ro.disconnect());

  withMotion(() => {
    // Title: the same per-character rise and width-axis settle as the home hero,
    // so arriving on a case study feels like the same site rather than a
    // document that happens to share a header.
    revealDisplayTitle();

    // Everything else is the shared entrance: a fade and a short rise, once, on
    // scroll. Nothing is pinned and nothing scrubs, so a reader is never waiting
    // on the page.
    revealOnScroll('[data-reveal]');
  });
</script>
