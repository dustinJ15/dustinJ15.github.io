---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, hero } from '../data/site';

// The work list reads the collection, so the home page and a case study cannot
// disagree about a project's year, stack or tagline.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

{/* The nav calls this page "Work", but the title is not just a tab label: BaseLayout
    feeds it to og:title and twitter:title too, so "Work · Dustin Jones" was the
    headline on every shared link card. It reads the same tokens the hero prints,
    so the tab and the page cannot drift apart. */}
<BaseLayout title={`${site.role}, ${site.location}`} description={site.description}>
  <!-- ── hero ──────────────────────────────────────────────────────────── -->
  <section
    class="relative flex min-h-[calc(100svh-6rem)] flex-col justify-between px-(--gutter) pb-10"
  >
    <p class="label">{site.role}, {site.location}</p>

    {/* Rows, not lines. A row is one visual line from lg up; below lg each phrase
        in it takes its own line, so the size is bound by "applications" rather
        than by "and the pipelines" and the type sets half again as large on a
        phone. `.hero-title` in global.css owns both sizes; the gate's wrap check
        is what keeps their constants honest. */}
    <h1
      class="hero-title my-auto py-4 font-display font-extrabold uppercase tracking-[-0.03em] sm:py-10"
    >
      {
        hero.displayRows.map((row, i) => (
          <Fragment>
            {/* The rows and the phrases inside them are block-level, so the
                heading's textContent runs them together without this and the
                page's primary heading reads "and thepipelines" to a copy-paste,
                to the computed accessible name and to any extractor. A
                whitespace-only text node renders as nothing either way round:
                between block boxes it collapses, and a flex container drops a
                text run that is only white space. */}
            {i > 0 && ' '}
            <span
              class:list={[
                'hero-row',
                i === hero.displayRows.length - 1 && 'text-accent',
                i % 2 === 1 && 'lg:pl-[8vw]',
              ]}
            >
              {row.map((phrase, j) => (
                <Fragment>
                  {j > 0 && ' '}
                  {/* overflow-clip with a margin rather than overflow-hidden: the
                      tracking is negative, so the last glyph in a word overhangs
                      its box and a hard clip takes the edge off the S. Same fix as
                      the case-study title. */}
                  <span class="block overflow-clip [overflow-clip-margin:0.15em]">
                    <span data-line class="block">
                      {phrase}
                    </span>
                  </span>
                </Fragment>
              ))}
            </span>
          </Fragment>
        ))
      }
    </h1>

    <div class="flex flex-wrap items-end justify-between gap-6 border-t border-line pt-5">
      {/* Deliberately not a [data-reveal]. It sits at the very bottom of the
          hero, so a scroll-triggered fade would leave the first screenful
          without the one line that says what the page holds. */}
      <p class="max-w-md text-base leading-relaxed text-ink-soft">
        Four case studies. Three built for a clinical lab, one for a property firm.
      </p>
      <a
        href="#rail"
        class="group inline-flex items-center gap-3 border border-accent px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-accent transition-colors duration-300 hover:bg-accent hover:text-accent-contrast"
      >
        See the work
        <span class="inline-block transition-transform duration-300 group-hover:translate-y-1"
          >↓</span
        >
      </a>
    </div>
  </section>

  {/* Native horizontal scroll by default, so every card is reachable at any
      width with no JavaScript at all. On a wide screen `horizontalRail` swaps
      that for a pinned, scrub-driven translation; reverted on teardown. */}
  <!-- ── work rail ─────────────────────────────────────────────────────── -->
  {/* `lg:min-h-svh` is what makes the pin honest. The section is pinned for
      exactly the scrub distance, and a 590px section pinned inside a 900px
      viewport leaves 310px of empty page under it for the whole of that scroll.
      At full height the pinned moment owns the screen and there is nothing
      below it to be empty. Below lg nothing is pinned, so nothing is stretched. */}
  <section
    id="rail"
    class="relative border-t border-line lg:flex lg:min-h-svh lg:flex-col lg:justify-center"
  >
    <div class="flex items-center justify-between px-(--gutter) py-6">
      <h2 class="label">Work</h2>
      {/* Was a bare span, which looked like a control and was not one: the first
          person shown the site tried to click it. It ships `hidden` and
          horizontalRail reveals it, so it only ever appears when it works. */}
      <button
        type="button"
        id="rail-next"
        hidden
        aria-controls="rail-scroller"
        aria-label="Scroll the work list right"
        class="label cursor-pointer transition-colors hover:text-accent disabled:pointer-events-none disabled:opacity-40"
      >
        Scroll <span aria-hidden="true">→</span>
      </button>
    </div>
    <div id="rail-scroller" class="overflow-x-auto overscroll-x-contain">
      <div id="rail-track" class="flex w-max gap-6 px-(--gutter) pb-10">
        {
          projects.map((p, i) => (
            <a
              href={`/projects/${p.id}/`}
              class="group flex w-[min(78vw,26rem)] shrink-0 flex-col justify-between border border-line bg-surface p-7 transition-colors duration-500 hover:border-accent hover:bg-surface-2"
            >
              <div>
                {/* The top of the tool, matted the way a case-study figure is.
                    Decorative: the card already says what the project is, and
                    the picture is a hint of it rather than information. */}
                {p.data.thumb && (
                  <div class="mb-7 border border-line-strong bg-line-strong p-px">
                    <Image
                      src={p.data.thumb}
                      alt=""
                      aria-hidden="true"
                      widths={[420, 840]}
                      sizes="(min-width: 640px) 26rem, 78vw"
                      class="aspect-[16/10] w-full object-cover object-top brightness-[0.94]"
                    />
                  </div>
                )}
                <div class="flex items-baseline justify-between">
                  <span class="font-mono text-5xl font-bold leading-none text-ink-faint transition-colors duration-500 group-hover:text-accent">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="label">{p.data.year}</span>
                </div>
                <h3 class="mt-8 font-display text-3xl font-bold uppercase leading-[0.95] tracking-tight text-ink">
                  {p.data.title}
                </h3>
                <p class="mt-4 text-base leading-relaxed text-ink-soft">{p.data.tagline}</p>
              </div>
              <div class="mt-8 border-t border-line pt-4">
                <ul class="flex flex-wrap gap-x-3 gap-y-1">
                  {p.data.stack.slice(0, 4).map((s) => (
                    <li class="font-mono text-2xs uppercase tracking-wider text-ink-faint">{s}</li>
                  ))}
                </ul>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── contact ───────────────────────────────────────────────────────── -->
  {/* Ruled, and with a leading padding that does not stack with the rail's
      trailing one. The two used to add up to 176px of unmarked ground between
      the last card and the word "Contact", which at 375 is a fifth of the
      screen and reads as the page having run out rather than having moved on. */}
  <section class="border-t border-line px-(--gutter) pb-28 pt-16">
    <h2 class="label">Contact</h2>
    <a
      href={`mailto:${site.email}`}
      class="mt-10 block font-display text-[clamp(1.5rem,8.5vw,4.5rem)] font-extrabold uppercase leading-none tracking-tight text-ink transition-colors duration-300 hover:text-accent"
      data-reveal
    >
      {site.email}
    </a>
    <div class="mt-12 flex flex-wrap gap-6 border-t border-line pt-6">
      <a class="label transition-colors hover:text-accent" href="/process/">Process</a>
      <a class="label transition-colors hover:text-accent" href="/about/">About</a>
      <a class="label transition-colors hover:text-accent" href={site.resume}>Resume</a>
      <a class="label transition-colors hover:text-accent" href={site.github}>GitHub</a>
      <a class="label transition-colors hover:text-accent" href={site.linkedin}>LinkedIn</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { withMotion, revealDisplayTitle, revealOnScroll, horizontalRail } from '../scripts/motion';

  const rail = document.getElementById('rail');
  const scroller = document.getElementById('rail-scroller');
  const railTrack = document.getElementById('rail-track');
  const railNext = document.getElementById('rail-next');

  // The work rail: native scroll at any width, pinned scrub from lg. Shared
  // with the case-study chapter rail, so the two behave identically.
  if (rail && scroller && railTrack) horizontalRail(rail, scroller, railTrack, railNext);

  withMotion(() => {
    // Hero: per-line rise, plus a width-axis settle only Bricolage's wdth axis
    // allows. Two lines, the same as a page title, so the default stagger.
    revealDisplayTitle();
    revealOnScroll('[data-reveal]');
  });
</script>
